# ==========================================================================
# Cloudflare Workers Assets 캐시 설정
# 지도 이미지가 3MB 남짓이라, 한 번 받은 태블릿은 다시 받지 않게 한다.
# (이 파일을 읽지 않는 호스팅에서는 무시되므로 같이 두어도 무해하다)
#
# 이미지는 7일, 코드(HTML·JS·CSS)는 매번 확인.
#
# 코드에 max-age 를 주면 안 된다. index.html 은 no-cache 라 늘 새것인데
# JS 만 낡아 있으면 화면과 코드가 어긋난 채로 돌아간다 — 배포 직후 그 시간 동안
# 학생 기기에서 앱이 깨질 수 있다. no-cache 는 "저장하되 매번 확인"이라
# 바뀐 게 없으면 304 만 오가므로 학교망에서도 부담이 없다.
#
# 이미지는 코드와 달리 어긋나도 문제가 없어 7일 그대로 둔다.
# 이미지를 교체했는데 옛 그림이 보이면 파일 이름을 바꿔 올리면 바로 반영된다.
# ==========================================================================

/assets/chart_orion.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/chart_color.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/chart_full.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/chart_stone.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/bill.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/2-2.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/2-3.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/2-5.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/bgm.mp3
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 코드는 매번 확인 — 화면(HTML)과 어긋나지 않도록
/assets/js/*
  Cache-Control: no-cache

/assets/style.css
  Cache-Control: no-cache

# 교사 설정과 첫 화면은 항상 최신으로
/config.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
